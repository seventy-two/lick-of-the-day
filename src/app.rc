#include <winres.h>
#include "resource.h"

IDI_APP ICON "app.ico"
// The General MIDI soundfont the player uses (Sonivox, Apache 2.0).
IDR_SOUNDFONT RCDATA "..\\res\\sonivox.sf2"

1 VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "FileDescription", "Lick of the Day"
            VALUE "ProductName", "Lick of the Day"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
